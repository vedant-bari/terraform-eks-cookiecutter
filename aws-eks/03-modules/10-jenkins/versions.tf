terraform {
  required_version = ">= 1.15.0"

  required_providers {
    # IAM role and Pod Identity association for the agents; the provider block
    # itself is generated by root.hcl.
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    kubernetes = {
      source  = "hashicorp/kubernetes"
      version = "~> 3.0"
    }
    helm = {
      source  = "hashicorp/helm"
      version = "~> 3.0"
    }
  }
}
